# Configuration du site et base de données
# Copie ce fichier en ".env" puis remplis chaque valeur avec tes vrais identifiants.
# Ne JAMAIS committer le fichier ".env" réel (déjà exclu via .gitignore).
SITE_URL=http://localhost/portfolio

DB_HOST=localhost
DB_NAME=nom_de_la_base
DB_USER=utilisateur_bdd
DB_PASS=mot_de_passe_bdd

ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-moi
ADMIN_NOTIFY_EMAIL=admin@example.com

# Configuration SMTP (se replie automatiquement sur mail() si SMTP_HOST ou SMTP_USERNAME est vide)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=votre-adresse@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application
SMTP_FROM_EMAIL=votre-adresse@gmail.com
SMTP_FROM_NAME=Portfolio
